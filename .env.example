# Copy to .env.local and fill in. Never commit a real key.

# --- Document reading -----------------------------------------------------
# Photographs and scanned PDFs are read by Google's Gemini, which handles
# handwriting and Tamil that no local reader managed. There is no local
# fallback: without a key the upload button is hidden and students fill the
# form in by hand.
#
# A PDF that already contains selectable text is read with `pdftotext` on the
# server instead and is never uploaded. Poppler is optional — if it is missing
# every PDF simply goes to Gemini too.
#
# Create a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# --- Database -------------------------------------------------------------
# Defaults to .thonmai/app.db
# THONMAI_DB_PATH=
